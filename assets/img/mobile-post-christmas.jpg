  <script>
    function notifyAngularOnGoogleScriptLoad() {
      var handler = window.googleScriptLoaded;
      if (handler && handler.zone && handler.initialiseGoogleLogin) {
        handler.zone.run(function () {
          handler.initialiseGoogleLogin();
        });
        return;
      }
      window.__googleScriptPendingLoad = true;
    }

    (function loadGoogleSignInScript() {
      var gsiScript = document.createElement('script');
      gsiScript.src = 'https://accounts.google.com/gsi/client';
      gsiScript.async = true;
      gsiScript.defer = true;
      gsiScript.onload = notifyAngularOnGoogleScriptLoad;
      document.head.appendChild(gsiScript);
    })();
  </script>
